# jkbase guest-kernel additions for the B2 layered runtime (WS0).
#
# Merged on top of Firecracker's recommended microVM config (which provides the
# virtio/boot/ext4 essentials), then resolved with `make olddefconfig`. These are
# the capabilities the pinned 4.14 dev kernel lacked and that the erofs/composefs
# layered runtime needs. See ~/.claude/plans/bubbly-brewing-popcorn.md (WS0) and
# the b2-build-rescope memory.

# --- erofs: the content-addressed read-only layer format (lowerdirs) ---
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_POSIX_ACL=y

# --- overlayfs: guest-side composition of base + app layers ---
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_METACOPY=y

# --- fs-verity: kernel-enforced integrity of trusted base layers (composefs) ---
# (overlayfs fs-verity validation is compiled in when OVERLAY_FS + FS_VERITY are
#  both present on >=6.6 — that is the reason for the kernel bump.)
CONFIG_FS_VERITY=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y

# --- dm-verity: whole-image integrity fallback ---
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y

# --- squashfs kept available (ext4-per-layer / squashfs fallback paths) ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# --- user namespaces + FUSE: required by the in-VM `builder = "dockerfile"`
# toolchain (buildah/crun, and fuse-overlayfs as the overlay fallback). The
# Firecracker baseline config happens to enable these today, but force them here
# so a baseline change can never silently drop them (build-kernel.sh also asserts
# them as must-haves). ---
CONFIG_USER_NS=y
CONFIG_FUSE_FS=y

# --- KVM PTP clock: the guest's host-disciplined wall-clock reference. ptp_kvm
# registers /dev/ptp0 ("KVM virtual PTP"); the agent reads the host's UTC from it
# (KVM_HC_CLOCK_PAIRING, no network) to correct both the free-running-tsc drift of
# running in a VM and the hibernate/resume time jump. The Firecracker baseline
# enables these today, but pin them so a baseline change can't silently drop the
# guest's ONLY time source (build-kernel.sh also asserts CONFIG_PTP_1588_CLOCK_KVM).
# NOTE: we deliberately do NOT pin `clocksource=kvm-clock` on the cmdline — that
# opts into a documented Firecracker restore regression (monotonic clock jumps on
# resume); the guest stays on the auto-selected tsc and the agent disciplines it. ---
CONFIG_PTP_1588_CLOCK=y
CONFIG_PTP_1588_CLOCK_KVM=y
